<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.*?>

<AnchorPane prefWidth="900.0" prefHeight="600.0"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.GameStore.Controller.TelaInicialController">

    <children>

        <VBox spacing="20"
              alignment="CENTER"
              AnchorPane.topAnchor="0.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="0.0">

            <Label text="GameStore"
                   style="-fx-font-size: 32px; -fx-font-weight: bold;" />

            <Label text="Bem-vindo ao sistema"
                   style="-fx-font-size: 16px;" />

            <Button text="Gerenciar Games"
                    prefWidth="200"
                    prefHeight="40"
                    onAction="#abrirGames"/>

            <Button text="Gerenciar Usuários"
                    prefWidth="200"
                    prefHeight="40"
                    onAction="#abrirUsuarios"/>

            <Button text="Ir para Loja"
                    prefWidth="200"
                    prefHeight="40"
                    onAction="#abrirMarket"/>

        </VBox>

    </children>
</AnchorPane>