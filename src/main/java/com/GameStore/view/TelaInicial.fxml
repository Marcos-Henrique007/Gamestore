<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>


<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.GameStore.view.TelaInicialController">
    <children>
        <VBox spacing="10" layoutX="150" layoutY="80">
            <Label text="Game Store" style="-fx-font-size: 20px;" />
            <Button text="Gerenciar Jogos" onAction="#abrirGames" />
            <Button text="Gerenciar Usuários" onAction="#abrirUsers" />
            <Button text="Marketplace" onAction="#abrirMarket" />
        </VBox>
    </children>
</AnchorPane>